{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "SSPL Design System — Singapore Seniors Pickleball League. Navy-and-yellow identity: deep navy as the authoritative ground, pickleball yellow as the only accent. Playfair Display for prestige editorial headings; Source Sans 3 for clear, legible body copy suited to senior audiences. Extracted from the SSPL landing-page mockup. Edit values here only; the dev server regenerates src/index.css and src/generated/tokens.tsx on every save.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#f3f6fa", "$description": "Page background — cool off-white with a slight blue cast" },
      "foreground":          { "$value": "#0d1f33", "$description": "Default body text — darkest navy ink" },
      "border":              { "$value": "#dde3ec" },
      "card":                { "$value": "#ffffff" },
      "cardForeground":      { "$value": "#0d1f33" },
      "popover":             { "$value": "#ffffff" },
      "popoverForeground":   { "$value": "#0d1f33" },
      "primary":             { "$value": "#0b1c2e", "$description": "Deep navy — topbar, section fills, dominant brand ground" },
      "primaryForeground":   { "$value": "#f0d800", "$description": "Yellow on navy — logo icon, badges on primary surfaces" },
      "secondary":           { "$value": "#faf8ee", "$description": "Warm cream — alternating section background (mission, districts)" },
      "secondaryForeground": { "$value": "#0d1f33" },
      "muted":               { "$value": "#edf1f7" },
      "mutedForeground":     { "$value": "#4f6478", "$description": "Body copy on light sections" },
      "accent":              { "$value": "#f0d800", "$description": "Pickleball yellow — the only accent: topbar rule, stat strip cap, dividers, eyebrow labels, HOF numbers, district left-border" },
      "accentForeground":    { "$value": "#0b1c2e", "$description": "Navy text/icon on yellow accent" },
      "destructive":         { "$value": "#c0392b" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input":               { "$value": "#dde3ec" },
      "ring":                { "$value": "#f0d800" },
      "chart1":              { "$value": "#f0d800", "$description": "Pickleball yellow" },
      "chart2":              { "$value": "#0b1c2e", "$description": "Deep navy" },
      "chart3":              { "$value": "#4f6478", "$description": "Slate muted" },
      "chart4":              { "$value": "#0e2240", "$description": "Dark navy" },
      "chart5":              { "$value": "#d4bc00", "$description": "Amber yellow — muted variant" },
      "sidebar":             { "$value": "#0b1c2e" },
      "sidebarForeground":   { "$value": "#e8edf4" },
      "sidebarBorder":       { "$value": "#1a3355" },
      "sidebarPrimary":      { "$value": "#f0d800" },
      "sidebarPrimaryForeground": { "$value": "#0b1c2e" },
      "sidebarAccent":       { "$value": "#1a3355" },
      "sidebarAccentForeground": { "$value": "#f0d800" },
      "sidebarRing":         { "$value": "#f0d800" }
    },
    "dark": {
      "background":          { "$value": "#0b1c2e", "$description": "Dark mode — the navy that is background on hero/feature sections" },
      "foreground":          { "$value": "#edf1f7" },
      "border":              { "$value": "#1e3355" },
      "card":                { "$value": "#0e2240" },
      "cardForeground":      { "$value": "#edf1f7" },
      "popover":             { "$value": "#0e2240" },
      "popoverForeground":   { "$value": "#edf1f7" },
      "primary":             { "$value": "#f0d800", "$description": "Yellow flips to primary on dark — CTA, active states" },
      "primaryForeground":   { "$value": "#0b1c2e" },
      "secondary":           { "$value": "#1a3355" },
      "secondaryForeground": { "$value": "#c8d4e0" },
      "muted":               { "$value": "#122540" },
      "mutedForeground":     { "$value": "#7a99b0" },
      "accent":              { "$value": "#ffe000", "$description": "Vivid yellow accent on dark surfaces" },
      "accentForeground":    { "$value": "#0b1c2e" },
      "destructive":         { "$value": "#e74c3c" },
      "destructiveForeground": { "$value": "#0b1c2e" },
      "input":               { "$value": "#1e3355" },
      "ring":                { "$value": "#f0d800" },
      "chart1":              { "$value": "#ffe000" },
      "chart2":              { "$value": "#7eb3d4" },
      "chart3":              { "$value": "#8aa0b8" },
      "chart4":              { "$value": "#c8d4e0" },
      "chart5":              { "$value": "#d4bc00" },
      "sidebar":             { "$value": "#081524" },
      "sidebarForeground":   { "$value": "#c8d4e0" },
      "sidebarBorder":       { "$value": "#1a2d44" },
      "sidebarPrimary":      { "$value": "#f0d800" },
      "sidebarPrimaryForeground": { "$value": "#0b1c2e" },
      "sidebarAccent":       { "$value": "#122540" },
      "sidebarAccentForeground": { "$value": "#f0d800" },
      "sidebarRing":         { "$value": "#f0d800" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Source Sans 3", "sans-serif"], "$description": "Body and UI face — generous x-height, highly legible at all sizes" },
      "serif": { "$value": ["Playfair Display", "serif"],   "$description": "Prestige editorial headings — italic emphasis for the hero pull-quote moments" },
      "mono":  { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Tight radius — 4px. The design uses sharp, boardroom-credible corners rather than friendly rounded ones." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
